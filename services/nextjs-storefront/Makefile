.PHONY: help install dev build start lint typecheck clean

help:
	@echo "OmniTix Storefront"
	@echo "  make install    — npm install"
	@echo "  make dev        — next dev on port 3000"
	@echo "  make build      — next build"
	@echo "  make start      — next start (production)"
	@echo "  make lint       — next lint"
	@echo "  make typecheck  — tsc --noEmit"
	@echo "  make clean      — remove node_modules and .next"

install:
	npm install

dev:
	npm run dev

build:
	npm run build

start:
	npm run start

lint:
	npm run lint

typecheck:
	npm run typecheck

clean:
	rm -rf node_modules .next