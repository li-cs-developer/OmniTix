# ═══════════════════════════════════════════════════════════
# OmniTix WS Gateway — Environment
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug

# ─── HTTP + WebSocket ───────────────────────────────────
WS_PORT=3001
WS_PATH=/ws
WS_CORS_ORIGIN=http://localhost:3000

# ─── Kafka (host-side connection) ───────────────────────
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_GROUP_ID=omnitix-realtime-ws
KAFKA_CLIENT_ID=omnitix-nestjs-ws

# ─── Redis (for shared presence + fan-out across replicas) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=2
REDIS_PASSWORD=

# ─── Batching (Phase 5.9) ───────────────────────────────
WS_BATCH_FLUSH_MS=50
WS_BATCH_MAX_SIZE=5000

# ─── Reconnect recovery (Phase 5.8) ─────────────────────
WS_STATE_RECOVERY_MAX_DISCONNECT=120

# ─── Go Inventory / Laravel (for snapshot fetch) ────────
INVENTORY_GRPC_HOST=127.0.0.1
INVENTORY_GRPC_PORT=50051
LARAVEL_INTERNAL_URL=http://localhost:8000