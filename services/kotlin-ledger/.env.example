# ═══════════════════════════════════════════════════════════
# OmniTix Ledger — local dev env
# ═══════════════════════════════════════════════════════════

APP_ENV=local
LOG_LEVEL=info

# ─── Database (Postgres in Docker) ──────────────────────
# From host: 127.0.0.1:5433 (the host-mapped port)
# From container: postgres:5432
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=omnitix
DB_USER=omnitix_ledger
DB_PASSWORD=omnitix_ledger_dev_password

# ─── Kafka ──────────────────────────────────────────────
# From host: 127.0.0.1:29092
# From container: kafka:9092
KAFKA_BROKERS=127.0.0.1:29092

# ─── gRPC + HTTP ────────────────────────────────────────
LEDGER_GRPC_PORT=50053
LEDGER_HTTP_PORT=8081

# ─── Payment adapter ────────────────────────────────────
PAYMENT_ADAPTER=mock