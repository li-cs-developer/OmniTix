# ═══════════════════════════════════════════════════════════
# OmniTix Storefront — Environment template
# Copy to .env (in this directory) for local dev.
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
NEXT_PORT=3000

# ─── Browser-visible URLs (NEXT_PUBLIC_*) ────────────────
NEXT_PUBLIC_LARAVEL_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_WS_PATH=/ws

# ─── Server-side only (never exposed to browser) ─────────
LARAVEL_INTERNAL_URL=http://localhost:8000
INVENTORY_INTERNAL_URL=http://localhost:8080
