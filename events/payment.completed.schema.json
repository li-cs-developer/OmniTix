{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitix.local/schemas/payment.completed.schema.json",
  "title": "payment.completed",
  "description": "Emitted by Kotlin Ledger when a charge succeeds. Triggers ticket issuance in Laravel.",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "properties": {
    "type": { "const": "payment.completed" },
    "payload": {
      "type": "object",
      "required": [
        "payment_id",
        "order_id",
        "user_id",
        "amount_cents",
        "currency",
        "provider_ref",
        "charged_at"
      ],
      "additionalProperties": false,
      "properties": {
        "payment_id":      { "type": "string" },
        "order_id":        { "type": "string" },
        "user_id":         { "type": "string" },
        "amount_cents":    { "type": "integer", "minimum": 0 },
        "currency":        { "type": "string", "minLength": 3, "maxLength": 3 },
        "provider":        { "type": "string", "enum": ["mock", "stripe"] },
        "provider_ref":    { "type": "string", "description": "Stripe charge ID or mock reference" },
        "charged_at":      { "type": "string", "format": "date-time" },
        "journal_entry_id": { "type": "string", "description": "ULID of the double-entry journal" }
      }
    }
  }
}