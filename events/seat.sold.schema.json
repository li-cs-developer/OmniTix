{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnitix.local/schemas/seat.sold.schema.json",
  "title": "seat.sold",
  "description": "Emitted when a held seat is confirmed as sold (payment succeeded). Terminal state for the seat.",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "properties": {
    "type": { "const": "seat.sold" },
    "payload": {
      "type": "object",
      "required": [
        "event_occurrence_id",
        "seat_id",
        "seat_label",
        "order_id",
        "user_id",
        "sold_at",
        "price_cents",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "event_occurrence_id": { "type": "string" },
        "seat_id":             { "type": "string" },
        "seat_label":          { "type": "string" },
        "order_id":            { "type": "string" },
        "user_id":             { "type": "string" },
        "sold_at":             { "type": "string", "format": "date-time" },
        "price_cents":         { "type": "integer", "minimum": 0 },
        "currency":            { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    }
  }
}