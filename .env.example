# ═══════════════════════════════════════════════════════════
# OmniTix — Environment template
# Copy to .env and fill in secrets. Never commit .env.
# ═══════════════════════════════════════════════════════════

# ─── Global ─────────────────────────────────────────────
APP_ENV=local
APP_NAME=OmniTix
APP_TIMEZONE=UTC

# ─── PostgreSQL (Docker) ────────────────────────────────
# NOTE: mapped to host 5433 to avoid clashing with a native
# host Postgres on 5432.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=omnitix
POSTGRES_USER=omnitix
POSTGRES_PASSWORD=omnitix_dev_password

# ─── Ledger (isolated schema, same Postgres instance) ───
LEDGER_SCHEMA=ledger
LEDGER_USER=omnitix_ledger
LEDGER_PASSWORD=omnitix_ledger_dev_password

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_HOST_PORT=9092
KAFKA_GROUP_PREFIX=omnitix

# ─── MinIO (S3-compatible) ──────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=omnitix
MINIO_ROOT_PASSWORD=omnitix_dev_password
MINIO_BUCKET_TICKETS=omnitix-tickets

# ─── Laravel Core ───────────────────────────────────────
LARAVEL_APP_KEY=
LARAVEL_APP_URL=http://localhost:8000
LARAVEL_HTTP_PORT=8000

# ─── Go Inventory ───────────────────────────────────────
INVENTORY_GRPC_PORT=50051
INVENTORY_HTTP_PORT=8080
INVENTORY_HOLD_TTL_SECONDS=600

# ─── Rust Crypto ────────────────────────────────────────
CRYPTO_GRPC_PORT=50052
CRYPTO_KEY_ID=v1
CRYPTO_KEY_PATH=/keys/ed25519_v1.pem

# ─── Kotlin Ledger ──────────────────────────────────────
LEDGER_GRPC_PORT=50053
LEDGER_HTTP_PORT=8081
PAYMENT_ADAPTER=mock

# ─── NestJS WebSocket ───────────────────────────────────
WS_PORT=3001
WS_HOST_PORT=3001

# ─── Next.js Storefront ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PORT=3000