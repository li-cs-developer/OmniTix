# ═══════════════════════════════════════════════════════════
# OmniTix Inventory Engine — Environment template
# Copy to .env (or .env.local) in this directory for local dev.
# ═══════════════════════════════════════════════════════════

APP_ENV=local
LOG_LEVEL=info

GRPC_PORT=50051
HTTP_PORT=8080
HOLD_TTL_SECONDS=600

# Host-mapped docker infra (6379 → 6380, 9092 → 29092)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=127.0.0.1:29092
KAFKA_CLIENT_ID=go-inventory
KAFKA_GROUP_PREFIX=omnitix
KAFKA_TOPIC_PREFIX=omnitix
